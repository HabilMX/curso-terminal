#!/usr/bin/env bash
# verifica — revisa el ESTADO de tu terminal de práctica y te dice qué falta.
# Corre ADENTRO del contenedor del curso. Uso:  verifica 00   ·   verifica 01   ·   verifica 02   ·   verifica 03
# Solo revisa cómo están las cosas: no califica predicciones ni explicaciones;
# esas las comparas tú con «Compara tus respuestas» de la lección.
# En la 00 escribe solo dos cosas, y las dos se dicen en su marca: para saber si
# ~/practica se puede escribir, crea un archivo vacío y lo borra enseguida; y para
# saber si saliste y volviste, anota en ~/practica/00/.sesion-verifica en qué sesión
# vio tu marca por primera vez. En la 01, la 02 y la 03 no escribe nada: solo lee.
# Las respuestas las escribes tú, con «anota».
set -uo pipefail

falta=0
si()   { echo "✅ $1"; }
no()   { echo "❌ $1"; falta=1; }

verifica_00() {
  local version usuario practica marca prueba apunte vista

  # --- 0.1 · Estás en la terminal del curso -------------------------------------
  version=$(. /etc/os-release 2>/dev/null && echo "${ID:-?} ${VERSION_ID:-?}")
  if [ "$version" = "ubuntu 26.04" ]; then
    si "Es Ubuntu 26.04 (medí: ID y VERSION_ID en /etc/os-release)"
  else
    no "No es Ubuntu 26.04: /etc/os-release dice «${version:-nada}». ¿Corriste verifica fuera del contenedor? Entra con ./practicar"
  fi

  usuario=$(id -un)
  if [ "$usuario" = "alumno" ]; then
    si "Eres el usuario alumno (medí: id -un)"
  else
    no "Eres «${usuario}», no alumno (medí: id -un). Sal con exit y vuelve a entrar con ./practicar"
  fi

  practica="$HOME/practica"
  if [ -d "$practica" ]; then
    si "$practica existe y es una carpeta (medí: que exista como carpeta)"
  else
    no "$practica no existe (medí: que exista como carpeta). Sal y vuelve a entrar con ./practicar"
  fi

  prueba="$practica/.verifica-prueba.$$"
  if [ -d "$practica" ] && : 2>/dev/null > "$prueba"; then
    rm -f "$prueba"
    si "Puedes escribir en $practica (medí: creé un archivo vacío ahí y lo borré)"
  else
    no "No puedes escribir en $practica (medí: intenté crear un archivo vacío ahí). Sal y corre ./practicar desde-cero"
  fi

  # --- 0.1 · Saliste y volviste a entrar sin perder tu carpeta -------------------
  # No se usa el reloj. ./practicar le pone a cada entrada un identificador distinto
  # (CURSO_TERMINAL_SESION). La primera vez que verifica ve tu marca, apunta en el
  # volumen en qué sesión la vio. Si después corre en OTRA sesión y la marca sigue
  # ahí, es que saliste, volviste y tu carpeta sobrevivió.
  marca="$practica/00/aqui-estuve.txt"
  apunte="$practica/00/.sesion-verifica"
  if [ ! -f "$marca" ]; then
    rm -f "$apunte" 2>/dev/null
    no "Falta $marca (medí: que el archivo exista). Créalo con el paso 2 de la lección, corre  verifica 00, sal con exit y vuelve a entrar"
  elif [ -z "${CURSO_TERMINAL_SESION:-}" ]; then
    no "No sé en qué sesión estás (medí: la variable CURSO_TERMINAL_SESION, que pone ./practicar, está vacía). Sal y entra con ./practicar"
  else
    vista=$(cat "$apunte" 2>/dev/null)
    if [ -z "$vista" ]; then
      if echo "$CURSO_TERMINAL_SESION" 2>/dev/null > "$apunte"; then
        no "Tu marca aqui-estuve.txt ya existe, y es la primera vez que la veo: fue en ESTA sesión (medí: no había apunte de una sesión anterior; lo acabo de dejar en 00/.sesion-verifica). Te falta salir con exit, volver a entrar con ./practicar y correr  verifica 00  otra vez"
      else
        no "Tu marca existe, pero no pude apuntar en qué sesión la vi (medí: intenté escribir 00/.sesion-verifica). Sal y corre ./practicar desde-cero"
      fi
    elif [ "$vista" = "$CURSO_TERMINAL_SESION" ]; then
      no "Tu marca aqui-estuve.txt existe, pero sigues en la misma sesión en que la vi por primera vez (medí: el apunte de 00/.sesion-verifica es de esta sesión). Te falta salir con exit, volver a entrar con ./practicar y correr  verifica 00  otra vez"
    else
      si "Saliste y volviste sin perder tu carpeta (medí: tu marca ya existía en una sesión anterior a esta, según el apunte de 00/.sesion-verifica)"
    fi
  fi
}

# --- Lección 01 -------------------------------------------------------------------
# El laberinto tiene una sola definición: la lista que también lee «prepara 01».
LISTA_01="/usr/local/share/curso-terminal/01-laberinto.txt"
# La carpeta de práctica va escrita completa, igual que en prepara.
PRACTICA_01="/home/alumno/practica"

# Los renglones útiles de la lista: sin comentarios ni renglones vacíos. Las columnas
# van separadas por un tabulador, y así se leen (IFS=$'\t' read -r, awk -F'\t').
lista_01() { grep -Ev '^[[:space:]]*(#|$)' "$LISTA_01"; }

# Lee de tus respuestas el valor de una clave («clave: valor»). Si la clave está
# varias veces, vale la última. Sale con 1 si no hay ningún renglón con esa clave.
# Tolera espacios de más, mayúsculas en la clave y «más» con acento.
respuesta_01() {
  awk -v clave="$1" '
    { sub(/\r$/, "") }
    {
      renglon = $0
      sub(/^[ \t]+/, "", renglon)
      corte = index(renglon, ":")
      if (corte == 0) next
      k = tolower(substr(renglon, 1, corte - 1))
      gsub(/[ \t]+$/, "", k); gsub(/á|Á/, "a", k)
      if (k != clave) next
      v = substr(renglon, corte + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", v)
      valor = v; hay = 1
    }
    END { if (!hay) exit 1; print valor }
  ' "$PRACTICA_01/respuestas/01.md"
}

# Una ruta se lee de dos maneras, y las dos tienen que dar el mismo lugar:
#   léxica  solo con lo escrito: se quitan los «.» y se aplican los «..», sin
#           mirar si algún nombre es un enlace (realpath -s)
#   física  la carpeta real a la que se llega, siguiendo los enlaces (realpath -P)
# Si las dos coinciden, la ruta pasa por carpetas de verdad. Si no, en el camino
# hay un enlace: un atajo, que no demuestra que sepas escribir la ruta.
lexica_01() { realpath -s -- "$1" 2>/dev/null; }
fisica_01() { realpath -e -P -- "$1" 2>/dev/null; }

# ¿Algún tramo de la ruta, tal como está escrita, es un enlace? Se recorre nombre
# por nombre. Hace falta además de comparar la léxica con la física: una ruta que
# entra por un enlace y luego sale con «..» puede dar el mismo lugar en las dos.
con_enlace_01() {
  local resto="$1" tramo camino=""
  case "$resto" in /*) camino="" ;; *) camino="." ;; esac
  while [ -n "$resto" ]; do
    tramo=${resto%%/*}
    case "$resto" in */*) resto=${resto#*/} ;; *) resto="" ;; esac
    [ -z "$tramo" ] && continue
    camino="$camino/$tramo"
    [ -L "$camino" ] && return 0
  done
  return 1
}

# Califica una ruta ya armada contra la carpeta destino. Contesta una palabra:
#   bien · no-existe · enlace · otra
ruta_01() {
  local candidata="$1" destino="$2" lex fis
  [ -d "$candidata" ] || { echo "no-existe"; return; }
  lex=$(lexica_01 "$candidata"); fis=$(fisica_01 "$candidata")
  if con_enlace_01 "$candidata" || [ "$lex" != "$fis" ]; then echo "enlace"
  elif [ "$lex" = "$destino" ]; then echo "bien"
  else echo "otra"; fi
}

verifica_01() {
  local raiz="$PRACTICA_01/01" hoja="$PRACTICA_01/respuestas/01.md"
  local tipo ruta fecha bytes real malo="" enlace="" cuantos=0
  local grande="" grande_bytes=-1 oculto="" inicio="" destino=""
  local dicho que_es fallo

  if [ ! -r "$LISTA_01" ]; then
    no "No encuentro la lista del laberinto (medí: que $LISTA_01 se pueda leer). Tu imagen es de antes de esta lección: sal y corre  ./practicar reconstruir"
    return
  fi

  # De la lista salen las respuestas correctas: el archivo de más bytes, el que
  # tiene un nombre que empieza con punto, y las carpetas de inicio y de destino.
  while IFS=$'\t' read -r tipo ruta fecha bytes; do
    case "$tipo" in
      inicio)  inicio="$raiz/$ruta" ;;
      destino) destino="$raiz/$ruta" ;;
      archivo)
        if [ "$bytes" -gt "$grande_bytes" ]; then grande_bytes=$bytes; grande=${ruta##*/}; fi
        case "${ruta##*/}" in .*) oculto=${ruta##*/} ;; esac ;;
    esac
  done < <(lista_01)

  # --- El laberinto está completo --------------------------------------------------
  # Cada carpeta y archivo de la lista tiene que estar ahí de verdad: uno que sea
  # un enlace, o al que se llegue pasando por un enlace, no cuenta.
  while IFS=$'\t' read -r tipo ruta fecha bytes; do
    case "$tipo" in carpeta|texto|archivo) ;; *) continue ;; esac
    if [ "$(fisica_01 "$raiz/$ruta")" != "$raiz/$ruta" ]; then
      if [ -e "$raiz/$ruta" ] || [ -L "$raiz/$ruta" ]; then enlace=${enlace:-$ruta}; else malo=${malo:-$ruta}; fi
      continue
    fi
    case "$tipo" in
      carpeta) [ -d "$raiz/$ruta" ] || { malo=${malo:-$ruta}; continue; } ;;
      texto)   [ -f "$raiz/$ruta" ] || { malo=${malo:-$ruta}; continue; } ;;
      archivo)
        real=$(stat -c %s "$raiz/$ruta" 2>/dev/null)
        [ -f "$raiz/$ruta" ] && [ "${real:-x}" = "$bytes" ] || { malo=${malo:-$ruta}; continue; } ;;
    esac
    cuantos=$((cuantos + 1))
  done < <(lista_01)
  if [ -n "$enlace" ]; then
    no "Tu laberinto no está completo: «$enlace» es un enlace, o se llega a él pasando por un enlace (medí: la ruta real de cada carpeta y archivo de la lista contra su lugar en $raiz). Ármalo de nuevo con  prepara 01"
  elif [ -n "$malo" ]; then
    no "Tu laberinto no está completo: falta o cambió «$malo» (medí: cada carpeta y archivo de la lista contra ~/practica/01, con su tamaño). Ármalo de nuevo con  prepara 01"
  else
    si "Tu laberinto está completo (medí: las $cuantos carpetas y archivos de la lista existen en ~/practica/01, ninguno es un enlace y cada archivo tiene su tamaño)"
  fi

  # --- Tu hoja de respuestas -------------------------------------------------------
  if [ ! -f "$hoja" ]; then
    no "Falta tu hoja de respuestas, ~/practica/respuestas/01.md (medí: que el archivo exista). La crea  prepara 01 . Sin ella no puedo revisar tus cuatro respuestas"
    return
  fi

  # --- 1.2 · El archivo más grande -------------------------------------------------
  if ! dicho=$(respuesta_01 "mas-grande"); then
    no "No encontré tu respuesta «mas-grande» (medí: busqué en respuestas/01.md un renglón que empiece con  mas-grande: )"
  elif [ -z "$dicho" ]; then
    no "Tu renglón «mas-grande:» está vacío (medí: lo que hay después de los dos puntos). Anótalo con  anota 01 mas-grande  y el nombre del archivo"
  elif [ "${dicho#*/}" != "$dicho" ]; then
    no "En «mas-grande» anotaste «$dicho», que lleva una diagonal (medí: que la respuesta no tenga / ). Va solo el nombre del archivo, como lo escribe ls, sin su carpeta"
  else
    # ¿Qué es en la lista lo que anotaste? «archivo», «texto», «carpeta» o nada.
    que_es=$(lista_01 | N="$dicho" awk -F'\t' '{ m = $2; sub(/.*\//, "", m) } m == ENVIRON["N"] && $1 != "inicio" && $1 != "destino" { print $1; exit }')
    if [ "$dicho" = "$grande" ]; then
      si "«$dicho» es el archivo más grande del laberinto (medí: comparé los bytes de cada archivo de la lista del laberinto)"
    elif [ "$que_es" = "carpeta" ]; then
      no "«$dicho» es una carpeta, no un archivo (medí: qué es ese nombre en la lista del laberinto). En  ls -l , el renglón de una carpeta empieza con d; el de un archivo, con un guion"
    elif [ -n "$que_es" ]; then
      no "«$dicho» no es el archivo más grande del laberinto (medí: comparé sus bytes contra los de los demás archivos de la lista; hay uno con más). Vuelve a leer la columna del tamaño con  ls -lh : fíjate en la letra, no solo en el número"
    else
      no "«$dicho» no es un archivo del laberinto (medí: busqué ese nombre tal cual, con sus mayúsculas, minúsculas y puntos, en la lista del laberinto). Anota solo el nombre, como lo escribe ls"
    fi
  fi

  # --- 1.2 · El archivo oculto -----------------------------------------------------
  if ! dicho=$(respuesta_01 "oculto"); then
    no "No encontré tu respuesta «oculto» (medí: busqué en respuestas/01.md un renglón que empiece con  oculto: )"
  elif [ -z "$dicho" ]; then
    no "Tu renglón «oculto:» está vacío (medí: lo que hay después de los dos puntos). Anótalo con  anota 01 oculto  y el nombre del archivo"
  elif [ "${dicho#*/}" != "$dicho" ]; then
    no "En «oculto» anotaste «$dicho», que lleva una diagonal (medí: que la respuesta no tenga / ). Va solo el nombre del archivo, como lo escribe ls -a, sin su carpeta"
  elif [ "$dicho" = "$oculto" ]; then
    si "«$dicho» es el archivo oculto del laberinto (medí: es el único archivo de la lista con un nombre que empieza con punto)"
  elif [ ".$dicho" = "$oculto" ]; then
    no "Anotaste «$dicho», sin el punto del principio (medí: comparé tu respuesta, letra por letra, con el nombre del archivo oculto). El punto es parte del nombre: anótalo como lo escribe  ls -a"
  else
    no "«$dicho» no es el archivo oculto del laberinto (medí: comparé tu respuesta con el único archivo de la lista con un nombre que empieza con punto). Búscalo con  ls -a  en la carpeta de las bitácoras"
  fi

  # --- 1.3 · La ruta absoluta ------------------------------------------------------
  if ! dicho=$(respuesta_01 "ruta-absoluta"); then
    no "No encontré tu respuesta «ruta-absoluta» (medí: busqué en respuestas/01.md un renglón que empiece con  ruta-absoluta: )"
  elif [ -z "$dicho" ]; then
    no "Tu renglón «ruta-absoluta:» está vacío (medí: lo que hay después de los dos puntos). Anótalo con  anota 01 ruta-absoluta  y tu ruta"
  elif [ "${dicho#/}" = "$dicho" ]; then
    no "«$dicho» no es una ruta absoluta (medí: que empiece con / ). Una ruta absoluta empieza en la raíz; «~» es una abreviatura, no la raíz"
  else
    fallo=$(ruta_01 "$dicho" "$destino")
    case "$fallo" in
      bien)      si "Tu ruta absoluta lleva a la carpeta destino (medí: empieza con /, existe, ningún tramo es un enlace, y tanto leída letra por letra como siguiéndola de verdad da $destino)" ;;
      no-existe) no "Tu ruta absoluta «$dicho» no existe o no es una carpeta (medí: que exista como carpeta). Compruébala con  cd  y  pwd  antes de anotarla" ;;
      enlace)    no "Tu ruta absoluta «$dicho» pasa por un enlace: un atajo que apunta a otra carpeta (medí: cada tramo de la ruta, que ninguno sea un enlace, y que la ruta leída letra por letra dé la misma carpeta que siguiéndola de verdad). Escribe el camino por las carpetas del laberinto" ;;
      *)         no "Tu ruta absoluta «$dicho» existe, pero no lleva a la carpeta destino (medí: siguiéndola llegué a «$(fisica_01 "$dicho")», no a la carpeta que pide el ejercicio 1.3)" ;;
    esac
  fi

  # --- 1.3 · La ruta relativa ------------------------------------------------------
  # Se prueba pegada a la carpeta de salida: «salida/tu-ruta». Así se lee siempre
  # como ruta, también si es un guion solo o lleva espacios.
  if ! dicho=$(respuesta_01 "ruta-relativa"); then
    no "No encontré tu respuesta «ruta-relativa» (medí: busqué en respuestas/01.md un renglón que empiece con  ruta-relativa: )"
  elif [ -z "$dicho" ]; then
    no "Tu renglón «ruta-relativa:» está vacío (medí: lo que hay después de los dos puntos). Anótalo con  anota 01 ruta-relativa  y tu ruta"
  elif [ "${dicho#/}" != "$dicho" ] || [ "${dicho#\~}" != "$dicho" ]; then
    no "«$dicho» no es una ruta relativa (medí: que NO empiece con / ni con ~ ). Una ruta relativa sale de la carpeta donde estás parado"
  elif [ "$(ruta_01 "$inicio" "$inicio")" != "bien" ]; then
    no "No pude probar tu ruta relativa: falta la carpeta de salida, $inicio, o es un enlace (medí: que exista como carpeta de verdad). Arma el laberinto con  prepara 01"
  else
    fallo=$(ruta_01 "$inicio/$dicho" "$destino")
    case "$fallo" in
      bien)      si "Tu ruta relativa lleva a la carpeta destino (medí: no empieza con / ni con ~, ningún tramo es un enlace, y saliendo de $inicio, tanto leída letra por letra como siguiéndola de verdad, da $destino)" ;;
      no-existe) no "Tu ruta relativa «$dicho» no existe saliendo de $inicio (medí: que exista como carpeta partiendo de ahí). Compruébala parado ahí, con  cd  y  pwd" ;;
      enlace)    no "Tu ruta relativa «$dicho» pasa por un enlace: un atajo que apunta a otra carpeta (medí: saliendo de $inicio, cada tramo de la ruta, que ninguno sea un enlace, y que la ruta leída letra por letra dé la misma carpeta que siguiéndola de verdad). Escribe el camino por las carpetas del laberinto" ;;
      *)         no "Tu ruta relativa «$dicho» existe, pero no lleva a la carpeta destino (medí: saliendo de $inicio llegué a «$(fisica_01 "$inicio/$dicho")», no a la carpeta que pide el ejercicio 1.3)" ;;
    esac
  fi
}

# --- Lección 02 -------------------------------------------------------------------
# El taller también tiene una sola definición: la lista que lee «prepara 02». De ahí
# salen el contenido de cada archivo y lo que pide cada ejercicio.
LISTA_02="/usr/local/share/curso-terminal/02-taller.txt"
PRACTICA_02="/home/alumno/practica"
RAIZ_02="$PRACTICA_02/02"

# La lista se lee una sola vez, igual que la lee prepara: columnas separadas por un
# tabulador (IFS=$'\t' read -r), así que un nombre puede llevar espacios. Todo queda
# en arreglos; ninguna lista de nombres se guarda en una cadena con espacios.
declare -A TIPO_02=() CONT_02=()
ORDEN_02=()                      # las carpetas y los archivos de la lista, en su orden
TAREA_02=() UNO_02=() DOS_02=()  # lo que pide cada ejercicio: tipo, ruta y segunda ruta
cargar_02() {
  local tipo a b c
  while IFS=$'\t' read -r tipo a b c || [ -n "$tipo" ]; do
    [[ $tipo =~ ^[[:space:]]*(#|$) ]] && continue
    case "$tipo" in
      carpeta) TIPO_02[$a]=carpeta; ORDEN_02+=("$a") ;;
      archivo) TIPO_02[$a]=archivo; CONT_02[$a]=$c; ORDEN_02+=("$a") ;;
      *)       TAREA_02+=("$tipo"); UNO_02+=("$a"); DOS_02+=("$b") ;;
    esac
  done < "$LISTA_02"
}

# La primera tarea de un tipo: deja su origen en T_O y su destino en T_D.
tarea_02() {
  local i
  T_O=""; T_D=""
  for i in "${!TAREA_02[@]}"; do
    if [ "${TAREA_02[i]}" = "$1" ]; then T_O=${UNO_02[i]}; T_D=${DOS_02[i]}; return 0; fi
  done
  return 1
}

# ¿El archivo tiene el contenido que la lista le da a «rel»? Falso si la lista no
# le da contenido a esa ruta.
igual_02() { [ -n "${CONT_02[$2]+x}" ] && cmp -s -- "$1" <(printf '%s\n' "${CONT_02[$2]}"); }

# Una ruta es «de verdad» si existe y su ruta real, siguiendo los enlaces, es ella
# misma. Si algún tramo es un enlace simbólico, la ruta real sale distinta.
real_02() { [ -e "$1" ] && [ "$(realpath -e -P -- "$1" 2>/dev/null)" = "$1" ]; }

# Es un enlace simbólico, o se llega a ella pasando por uno.
enlazada_02() { [ -L "$1" ] || { [ -e "$1" ] && ! real_02 "$1"; }; }

# Un enlace duro no se ve con realpath: es el MISMO archivo con dos nombres. Se nota
# en que los dos nombres tienen el mismo inode (el número del archivo en el disco).
# Una copia de verdad es otro archivo, con su propio inode.
inode_02() { stat -c '%d:%i' -- "$1" 2>/dev/null; }
independiente_02() {
  local uno dos
  uno=$(inode_02 "$1"); dos=$(inode_02 "$2")
  [ -z "$uno" ] || [ -z "$dos" ] || [ "$uno" != "$dos" ]
}

# Ya no existe: ni como archivo o carpeta, ni como enlace. Y su carpeta, si sigue
# ahí, es de verdad: si fuera un enlace, «no está» no diría nada de tu carpeta.
ausente_02() {
  local padre="${1%/*}"
  [ ! -e "$1" ] && [ ! -L "$1" ] || return 1
  if [ -e "$padre" ] || [ -L "$padre" ]; then real_02 "$padre"; fi
}

# El archivo es de verdad y tiene el contenido que la lista le da a «rel».
contiene_02() { [ -f "$1" ] && real_02 "$1" && igual_02 "$1" "$2"; }

# Lee de tu hoja el valor de una clave; si está varias veces, vale la última.
respuesta_02() {
  awk -v clave="$1" '
    { sub(/\r$/, "") }
    {
      renglon = $0
      sub(/^[ \t]+/, "", renglon)
      corte = index(renglon, ":")
      if (corte == 0) next
      k = tolower(substr(renglon, 1, corte - 1))
      gsub(/[ \t]+$/, "", k); gsub(/á|Á/, "a", k); gsub(/ó|Ó/, "o", k)
      if (k != clave) next
      v = substr(renglon, corte + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", v)
      valor = v; hay = 1
    }
    END { if (!hay) exit 1; print valor }
  ' "$PRACTICA_02/respuestas/02.md"
}

# Lo que hay adentro de una carpeta, con su ruta relativa, en el arreglo HAY_02.
# find no sigue enlaces, así que un enlace aparece con su propio nombre. Se lee
# separado por el carácter nulo: un nombre con espacios llega entero.
adentro_02() {
  local n
  HAY_02=()
  while IFS= read -r -d '' n; do HAY_02+=("$n"); done < <(find "$1" -mindepth 1 -printf '%P\0' | sort -z)
}

# --- 2.1 · El árbol que creas tú ---------------------------------------------------
marca_arbol_02() {
  local i tipo ruta p n hueco="" enlace="" mal_tipo="" sobra="" carpetas=0 archivos=0
  local -A pedido=()
  for i in "${!TAREA_02[@]}"; do
    tipo=${TAREA_02[i]}; ruta=${UNO_02[i]}
    case "$tipo" in crea-carpeta|crea-archivo) ;; *) continue ;; esac
    pedido[$ruta]=1
    p="$RAIZ_02/$ruta"
    if enlazada_02 "$p"; then enlace=${enlace:-$ruta}
    elif [ ! -e "$p" ]; then hueco=${hueco:-$ruta}
    elif [ "$tipo" = "crea-carpeta" ] && [ ! -d "$p" ]; then [ -n "$mal_tipo" ] || mal_tipo=("$ruta" "un archivo" "una carpeta")
    elif [ "$tipo" = "crea-archivo" ] && [ ! -f "$p" ]; then [ -n "$mal_tipo" ] || mal_tipo=("$ruta" "una carpeta" "un archivo")
    elif [ "$tipo" = "crea-carpeta" ]; then carpetas=$((carpetas + 1))
    else archivos=$((archivos + 1)); fi
  done
  if real_02 "$RAIZ_02/guardia" && [ -d "$RAIZ_02/guardia" ]; then
    adentro_02 "$RAIZ_02/guardia"
    for n in "${HAY_02[@]}"; do
      [ -n "${pedido["guardia/$n"]+x}" ] || sobra=${sobra:-"guardia/$n"}
    done
  fi
  if [ -n "$enlace" ]; then
    no "2.1 · «$enlace» es un enlace, o se llega a él pasando por un enlace (medí: la ruta real de cada carpeta y archivo pedido). Créalo con mkdir o con touch"
  elif [ -n "$hueco" ]; then
    no "2.1 · Falta «$hueco» (medí: cada carpeta y archivo pedido, en ~/practica/02). Revisa el nombre letra por letra con  ls"
  elif [ -n "$mal_tipo" ]; then
    no "2.1 · «${mal_tipo[0]}» existe, pero es ${mal_tipo[1]} y se pedía ${mal_tipo[2]} (medí: el tipo de cada cosa pedida). mkdir crea carpetas; touch, archivos"
  elif [ -n "$sobra" ]; then
    no "2.1 · Adentro de guardia hay algo que no se pidió: «$sobra» (medí: todo lo que hay en guardia contra lo pedido). ¿Un error de dedo? Lo quitas con lo que ves en el paso 4"
  else
    si "2.1 · El árbol de guardia está tal cual (medí: las $carpetas carpetas y los $archivos archivos pedidos existen, cada uno de su tipo, ninguno es un enlace y no hay nada de más en guardia)"
  fi
}

# --- 2.2 · Una copia sobre un archivo que ya existía ---------------------------------
marca_copia_02() {
  local o d
  tarea_02 copia; o=$T_O; d=$T_D
  if enlazada_02 "$RAIZ_02/$d"; then
    no "2.2 · $d es un enlace, no una copia (medí: la ruta real de $d). Un enlace muestra el mismo contenido, pero no es un respaldo: si cambia el original, cambia él. Copia con cp"
  elif [ ! -f "$RAIZ_02/$d" ]; then
    no "2.2 · Falta $d (medí: que exista como archivo). Arma el taller de nuevo con  prepara 02"
  elif ! independiente_02 "$RAIZ_02/$o" "$RAIZ_02/$d"; then
    no "2.2 · $d es un enlace duro a $o, no una copia (medí: el inode de los dos, con stat: es el mismo). Un enlace duro parece un archivo normal, pero es el mismo archivo con dos nombres: si cambias uno, cambia el otro. Copia con cp"
  elif igual_02 "$RAIZ_02/$d" "$d"; then
    no "2.2 · $d todavía tiene la versión vieja (medí: comparé su contenido con el que tenía al armar el taller). Te falta copiar $o encima"
  elif ! igual_02 "$RAIZ_02/$d" "$o"; then
    no "2.2 · $d tiene un contenido que no es el de $o (medí: comparé los dos contenidos). Copia otra vez: cp no pregunta, escribe encima"
  elif ! contiene_02 "$RAIZ_02/$o" "$o"; then
    no "2.2 · $d ya es la versión buena, pero $o ya no está en su lugar, o cambió (medí: que el original exista, sea de verdad y conserve su contenido). ¿Usaste mv en lugar de cp?"
  else
    si "2.2 · $d es copia de $o (medí: su contenido es el de $o y no el viejo, el original sigue en su lugar con su contenido, ninguno de los dos es un enlace y cada uno es su propio archivo, con su propio inode)"
  fi
}

# --- 2.2 · Una carpeta copiada entera, con cp -r --------------------------------------
marca_copia_carpeta_02() {
  local o d ruta rel p n cuantos=0 hueco="" enlace="" duro="" distinto="" sobra="" original=1
  local -A esperado=()
  tarea_02 copia-carpeta; o=$T_O; d=$T_D
  for ruta in "${ORDEN_02[@]}"; do
    case "$ruta" in "$o"/*) ;; *) continue ;; esac
    rel=${ruta#"$o"/}; esperado[$rel]=1
    p="$RAIZ_02/$d/$rel"
    if enlazada_02 "$p"; then enlace=${enlace:-"$d/$rel"}
    elif [ "${TIPO_02[$ruta]}" = "carpeta" ]; then
      if [ -d "$p" ]; then cuantos=$((cuantos + 1)); else hueco=${hueco:-"$d/$rel"}; fi
    elif [ ! -f "$p" ]; then hueco=${hueco:-"$d/$rel"}
    elif ! independiente_02 "$RAIZ_02/$ruta" "$p"; then duro=${duro:-"$d/$rel"}
    elif igual_02 "$p" "$ruta"; then cuantos=$((cuantos + 1))
    else distinto=${distinto:-"$d/$rel"}; fi
    if [ "${TIPO_02[$ruta]}" = "archivo" ]; then contiene_02 "$RAIZ_02/$ruta" "$ruta" || original=0
    else { [ -d "$RAIZ_02/$ruta" ] && real_02 "$RAIZ_02/$ruta"; } || original=0; fi
  done
  if real_02 "$RAIZ_02/$d" && [ -d "$RAIZ_02/$d" ]; then
    adentro_02 "$RAIZ_02/$d"
    for n in "${HAY_02[@]}"; do
      [ -n "${esperado[$n]+x}" ] || sobra=${sobra:-$n}
    done
  fi
  if enlazada_02 "$RAIZ_02/$d"; then
    no "2.2 · $d es un enlace a otra carpeta, no una copia (medí: la ruta real de $d). Copia la carpeta con cp y la opción para carpetas"
  elif [ ! -d "$RAIZ_02/$d" ]; then
    no "2.2 · Falta la carpeta $d (medí: que exista como carpeta). cp copia una carpeta solo con su opción para carpetas: búscala en el paso 3"
  elif [ -n "$enlace" ]; then
    no "2.2 · Adentro de $d, «$enlace» es un enlace, no una copia (medí: la ruta real de cada cosa copiada)"
  elif [ -n "$duro" ]; then
    no "2.2 · Adentro de $d, «$duro» es un enlace duro a su original, no una copia (medí: el inode de cada archivo copiado contra el de su original, con stat: es el mismo). Un enlace duro parece un archivo normal, pero es el mismo archivo con dos nombres: si cambias uno, cambia el otro"
  elif [ "${sobra%%/*}" = "${o##*/}" ]; then
    no "2.2 · Adentro de $d hay otra $sobra (medí: todo lo que hay en $d contra lo que hay en $o). Copiaste dos veces: la segunda copia, como el destino ya existía, quedó ADENTRO de la primera"
  elif [ -n "$hueco" ]; then
    no "2.2 · A la copia le falta «$hueco» (medí: cada archivo de $o, buscado en $d)"
  elif [ -n "$distinto" ]; then
    no "2.2 · «$distinto» tiene otro contenido que su original (medí: comparé el contenido de cada archivo copiado con el de $o)"
  elif [ -n "$sobra" ]; then
    no "2.2 · Adentro de $d hay algo que no está en $o: «$sobra» (medí: todo lo que hay en $d contra lo que hay en $o)"
  elif [ "$original" -eq 0 ]; then
    no "2.2 · La copia está bien, pero $o ya no está completa en su lugar (medí: cada archivo del original, con su contenido). ¿Usaste mv en lugar de cp?"
  else
    si "2.2 · $d es copia de $o (medí: lo mismo que $o, $cuantos cosas en total, cada archivo con el mismo contenido que su original y su propio inode, nada de más, el original completo y ningún enlace)"
  fi
}

# --- 2.2 · Renombrar y mover: el original desaparece ----------------------------------
# «verbo» va en el mensaje: renombrar o mover. El destino de «mueve» ya existía con
# otro contenido; el de «renombra», no.
marca_mueve_02() {
  local tarea="$1" verbo="$2" o d
  tarea_02 "$tarea"; o=$T_O; d=$T_D
  if enlazada_02 "$RAIZ_02/$d"; then
    no "2.2 · $d es un enlace (medí: la ruta real de $d). Se pide el archivo mismo, con mv"
  elif [ ! -f "$RAIZ_02/$d" ]; then
    no "2.2 · Falta $d (medí: que exista como archivo). Te falta $verbo $o"
  elif igual_02 "$RAIZ_02/$d" "$d"; then
    no "2.2 · $d todavía tiene el contenido viejo (medí: comparé su contenido con el que tenía al armar el taller). Te falta $verbo $o encima"
  elif ! igual_02 "$RAIZ_02/$d" "$o"; then
    no "2.2 · $d no tiene el contenido de $o (medí: comparé los dos contenidos)"
  elif ! ausente_02 "$RAIZ_02/$o"; then
    no "2.2 · $d ya tiene el contenido bueno, pero $o sigue ahí (medí: que $o ya no exista, ni como enlace). Eso fue copiar: al $verbo, el nombre de antes desaparece"
  else
    si "2.2 · $o quedó como $d (medí: $o ya no existe, $d tiene el contenido que tenía $o y no es un enlace)"
  fi
}

# --- 2.3 · Tu patrón -------------------------------------------------------------------
marca_patron_02() {
  local hoja="$PRACTICA_02/respuestas/02.md" dicho i ruta nombre todos=0
  local deja="" atrapa="" palabra todas=1 debe deben=0
  local -a nombres=() palabras=()
  local -A es_nombre=() se_borra=()
  if [ ! -f "$hoja" ] || enlazada_02 "$hoja"; then
    no "2.3 · Falta tu hoja de respuestas, ~/practica/respuestas/02.md (medí: que exista como archivo y no sea un enlace). La crea  prepara 02"
    return
  fi
  if ! dicho=$(respuesta_02 patron); then
    no "2.3 · No encontré tu respuesta «patron» (medí: busqué en respuestas/02.md un renglón que empiece con  patron: )"
    return
  fi
  if [ -z "$dicho" ]; then
    no "2.3 · Tu renglón «patron:» está vacío (medí: lo que hay después de los dos puntos). Anótalo con  anota 02 patron  y tu patrón entre comillas simples"
    return
  fi
  # Los nombres que prepara puso directamente en limpieza, y cuáles se borran con el patrón.
  for ruta in "${ORDEN_02[@]}"; do
    case "$ruta" in limpieza/*/*) continue ;; limpieza/*) ;; *) continue ;; esac
    nombres+=("${ruta#limpieza/}"); es_nombre[${ruta#limpieza/}]=1; todos=$((todos + 1))
  done
  for i in "${!TAREA_02[@]}"; do
    [ "${TAREA_02[i]}" = "borra-patron" ] && se_borra[${UNO_02[i]}]=1
  done
  case "$dicho" in
    */*) no "2.3 · Tu patrón «$dicho» lleva una diagonal (medí: que no tenga / ). Va solo el patrón, como lo escribes parado en limpieza"; return ;;
  esac
  case "$dicho" in
    *[[:space:]]*)
      # read -a parte en palabras sin expandir los * (un for sobre $dicho sí los expandiría).
      read -r -a palabras <<< "$dicho"
      for palabra in "${palabras[@]}"; do [ -n "${es_nombre[$palabra]+x}" ] || todas=0; done
      if [ "$todas" -eq 1 ]; then
        no "2.3 · Anotaste «$dicho»: son nombres, no un patrón (medí: cada palabra de tu respuesta es un nombre de limpieza). La terminal cambió tu patrón por lo que atrapa antes de que anota lo viera. Anótalo entre comillas simples"
      else
        no "2.3 · Tu patrón «$dicho» lleva espacios (medí: que sea una sola palabra). Anota un solo patrón, entre comillas simples"
      fi
      return ;;
  esac
  case "$dicho" in
    *[\*\?\[]*) ;;
    *) no "2.3 · «$dicho» es un nombre, no un patrón (medí: que lleve * , ? o [ ). Un patrón atrapa varios nombres de un jalón"; return ;;
  esac
  for nombre in "${nombres[@]}"; do
    debe=0
    if [ -n "${se_borra["limpieza/$nombre"]+x}" ]; then debe=1; deben=$((deben + 1)); fi
    # El patrón se prueba con case, sin comillas: así lo interpreta la terminal.
    # shellcheck disable=SC2254
    case "$nombre" in
      $dicho) [ "$debe" -eq 1 ] || atrapa=${atrapa:-$nombre} ;;
      *)      [ "$debe" -eq 0 ] || deja=${deja:-$nombre} ;;
    esac
  done
  if [ -n "$deja" ]; then
    no "2.3 · Tu patrón «$dicho» deja fuera «$deja», que sí se borra (medí: probé tu patrón contra los $todos nombres que prepara puso en limpieza)"
  elif [ -n "$atrapa" ]; then
    no "2.3 · Tu patrón «$dicho» también atrapa «$atrapa», que no debe caer con él (medí: probé tu patrón contra los $todos nombres que prepara puso en limpieza)"
  else
    si "2.3 · Tu patrón «$dicho» atrapa justo lo que se borra (medí: lo probé contra los $todos nombres que prepara puso en limpieza: atrapa los $deben que se borran con él y ninguno de los otros $((todos - deben)))"
  fi
}

# --- 2.3 · Se borró lo pedido ---------------------------------------------------------
marca_borrado_02() {
  local i ruta cuantos=0 sigue=""
  for i in "${!TAREA_02[@]}"; do
