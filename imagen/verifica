#!/usr/bin/env bash
# verifica — revisa el ESTADO de tu terminal de práctica y te dice qué falta.
# Corre ADENTRO del contenedor del curso. Uso:  verifica 00   ·   verifica 01
# Solo revisa cómo están las cosas: no califica predicciones ni explicaciones;
# esas las comparas tú con «Compara tus respuestas» de la lección.
# En la 00 escribe solo dos cosas, y las dos se dicen en su marca: para saber si
# ~/practica se puede escribir, crea un archivo vacío y lo borra enseguida; y para
# saber si saliste y volviste, anota en ~/practica/00/.sesion-verifica en qué sesión
# vio tu marca por primera vez. En la 01 no escribe nada: solo lee.
# Las respuestas las escribes tú, con «anota».
set -uo pipefail

falta=0
si()   { echo "✅ $1"; }
no()   { echo "❌ $1"; falta=1; }

verifica_00() {
  local version usuario practica marca prueba apunte vista

  # --- 0.1 · Estás en la terminal del curso -------------------------------------
  version=$(. /etc/os-release 2>/dev/null && echo "${ID:-?} ${VERSION_ID:-?}")
  if [ "$version" = "ubuntu 26.04" ]; then
    si "Es Ubuntu 26.04 (medí: ID y VERSION_ID en /etc/os-release)"
  else
    no "No es Ubuntu 26.04: /etc/os-release dice «${version:-nada}». ¿Corriste verifica fuera del contenedor? Entra con ./practicar"
  fi

  usuario=$(id -un)
  if [ "$usuario" = "alumno" ]; then
    si "Eres el usuario alumno (medí: id -un)"
  else
    no "Eres «${usuario}», no alumno (medí: id -un). Sal con exit y vuelve a entrar con ./practicar"
  fi

  practica="$HOME/practica"
  if [ -d "$practica" ]; then
    si "$practica existe y es una carpeta (medí: que exista como carpeta)"
  else
    no "$practica no existe (medí: que exista como carpeta). Sal y vuelve a entrar con ./practicar"
  fi

  prueba="$practica/.verifica-prueba.$$"
  if [ -d "$practica" ] && : 2>/dev/null > "$prueba"; then
    rm -f "$prueba"
    si "Puedes escribir en $practica (medí: creé un archivo vacío ahí y lo borré)"
  else
    no "No puedes escribir en $practica (medí: intenté crear un archivo vacío ahí). Sal y corre ./practicar desde-cero"
  fi

  # --- 0.1 · Saliste y volviste a entrar sin perder tu carpeta -------------------
  # No se usa el reloj. ./practicar le pone a cada entrada un identificador distinto
  # (CURSO_TERMINAL_SESION). La primera vez que verifica ve tu marca, apunta en el
  # volumen en qué sesión la vio. Si después corre en OTRA sesión y la marca sigue
  # ahí, es que saliste, volviste y tu carpeta sobrevivió.
  marca="$practica/00/aqui-estuve.txt"
  apunte="$practica/00/.sesion-verifica"
  if [ ! -f "$marca" ]; then
    rm -f "$apunte" 2>/dev/null
    no "Falta $marca (medí: que el archivo exista). Créalo con el paso 2 de la lección, corre  verifica 00, sal con exit y vuelve a entrar"
  elif [ -z "${CURSO_TERMINAL_SESION:-}" ]; then
    no "No sé en qué sesión estás (medí: la variable CURSO_TERMINAL_SESION, que pone ./practicar, está vacía). Sal y entra con ./practicar"
  else
    vista=$(cat "$apunte" 2>/dev/null)
    if [ -z "$vista" ]; then
      if echo "$CURSO_TERMINAL_SESION" 2>/dev/null > "$apunte"; then
        no "Tu marca aqui-estuve.txt ya existe, y es la primera vez que la veo: fue en ESTA sesión (medí: no había apunte de una sesión anterior; lo acabo de dejar en 00/.sesion-verifica). Te falta salir con exit, volver a entrar con ./practicar y correr  verifica 00  otra vez"
      else
        no "Tu marca existe, pero no pude apuntar en qué sesión la vi (medí: intenté escribir 00/.sesion-verifica). Sal y corre ./practicar desde-cero"
      fi
    elif [ "$vista" = "$CURSO_TERMINAL_SESION" ]; then
      no "Tu marca aqui-estuve.txt existe, pero sigues en la misma sesión en que la vi por primera vez (medí: el apunte de 00/.sesion-verifica es de esta sesión). Te falta salir con exit, volver a entrar con ./practicar y correr  verifica 00  otra vez"
    else
      si "Saliste y volviste sin perder tu carpeta (medí: tu marca ya existía en una sesión anterior a esta, según el apunte de 00/.sesion-verifica)"
    fi
  fi
}

# --- Lección 01 -------------------------------------------------------------------
# El laberinto tiene una sola definición: la lista que también lee «prepara 01».
LISTA_01="/usr/local/share/curso-terminal/01-laberinto.txt"
# La carpeta de práctica va escrita completa, igual que en prepara.
PRACTICA_01="/home/alumno/practica"

# Los renglones útiles de la lista: sin comentarios ni renglones vacíos.
lista_01() { grep -Ev '^[[:space:]]*(#|$)' "$LISTA_01"; }

# Lee de tus respuestas el valor de una clave («clave: valor»). Si la clave está
# varias veces, vale la última. Sale con 1 si no hay ningún renglón con esa clave.
# Tolera espacios de más, mayúsculas en la clave y «más» con acento.
respuesta_01() {
  awk -v clave="$1" '
    { sub(/\r$/, "") }
    {
      renglon = $0
      sub(/^[ \t]+/, "", renglon)
      corte = index(renglon, ":")
      if (corte == 0) next
      k = tolower(substr(renglon, 1, corte - 1))
      gsub(/[ \t]+$/, "", k); gsub(/á|Á/, "a", k)
      if (k != clave) next
      v = substr(renglon, corte + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", v)
      valor = v; hay = 1
    }
    END { if (!hay) exit 1; print valor }
  ' "$PRACTICA_01/respuestas/01.md"
}

# Una ruta se lee de dos maneras, y las dos tienen que dar el mismo lugar:
#   léxica  solo con lo escrito: se quitan los «.» y se aplican los «..», sin
#           mirar si algún nombre es un enlace (realpath -s)
#   física  la carpeta real a la que se llega, siguiendo los enlaces (realpath -P)
# Si las dos coinciden, la ruta pasa por carpetas de verdad. Si no, en el camino
# hay un enlace: un atajo, que no demuestra que sepas escribir la ruta.
lexica_01() { realpath -s -- "$1" 2>/dev/null; }
fisica_01() { realpath -e -P -- "$1" 2>/dev/null; }

# ¿Algún tramo de la ruta, tal como está escrita, es un enlace? Se recorre nombre
# por nombre. Hace falta además de comparar la léxica con la física: una ruta que
# entra por un enlace y luego sale con «..» puede dar el mismo lugar en las dos.
con_enlace_01() {
  local resto="$1" tramo camino=""
  case "$resto" in /*) camino="" ;; *) camino="." ;; esac
  while [ -n "$resto" ]; do
    tramo=${resto%%/*}
    case "$resto" in */*) resto=${resto#*/} ;; *) resto="" ;; esac
    [ -z "$tramo" ] && continue
    camino="$camino/$tramo"
    [ -L "$camino" ] && return 0
  done
  return 1
}

# Califica una ruta ya armada contra la carpeta destino. Contesta una palabra:
#   bien · no-existe · enlace · otra
ruta_01() {
  local candidata="$1" destino="$2" lex fis
  [ -d "$candidata" ] || { echo "no-existe"; return; }
  lex=$(lexica_01 "$candidata"); fis=$(fisica_01 "$candidata")
  if con_enlace_01 "$candidata" || [ "$lex" != "$fis" ]; then echo "enlace"
  elif [ "$lex" = "$destino" ]; then echo "bien"
  else echo "otra"; fi
}

verifica_01() {
  local raiz="$PRACTICA_01/01" hoja="$PRACTICA_01/respuestas/01.md"
  local tipo ruta fecha bytes real malo="" enlace="" cuantos=0
  local grande="" grande_bytes=-1 oculto="" inicio="" destino=""
  local dicho que_es fallo

  if [ ! -r "$LISTA_01" ]; then
    no "No encuentro la lista del laberinto (medí: que $LISTA_01 se pueda leer). Tu imagen es de antes de esta lección: sal y corre  ./practicar reconstruir"
    return
  fi

  # De la lista salen las respuestas correctas: el archivo de más bytes, el que
  # tiene un nombre que empieza con punto, y las carpetas de inicio y de destino.
  while read -r tipo ruta fecha bytes; do
    case "$tipo" in
      inicio)  inicio="$raiz/$ruta" ;;
      destino) destino="$raiz/$ruta" ;;
      archivo)
        if [ "$bytes" -gt "$grande_bytes" ]; then grande_bytes=$bytes; grande=${ruta##*/}; fi
        case "${ruta##*/}" in .*) oculto=${ruta##*/} ;; esac ;;
    esac
  done < <(lista_01)

  # --- El laberinto está completo --------------------------------------------------
  # Cada carpeta y archivo de la lista tiene que estar ahí de verdad: uno que sea
  # un enlace, o al que se llegue pasando por un enlace, no cuenta.
  while read -r tipo ruta fecha bytes; do
    case "$tipo" in carpeta|texto|archivo) ;; *) continue ;; esac
    if [ "$(fisica_01 "$raiz/$ruta")" != "$raiz/$ruta" ]; then
      if [ -e "$raiz/$ruta" ] || [ -L "$raiz/$ruta" ]; then enlace=${enlace:-$ruta}; else malo=${malo:-$ruta}; fi
      continue
    fi
    case "$tipo" in
      carpeta) [ -d "$raiz/$ruta" ] || { malo=${malo:-$ruta}; continue; } ;;
      texto)   [ -f "$raiz/$ruta" ] || { malo=${malo:-$ruta}; continue; } ;;
      archivo)
        real=$(stat -c %s "$raiz/$ruta" 2>/dev/null)
        [ -f "$raiz/$ruta" ] && [ "${real:-x}" = "$bytes" ] || { malo=${malo:-$ruta}; continue; } ;;
    esac
    cuantos=$((cuantos + 1))
  done < <(lista_01)
  if [ -n "$enlace" ]; then
    no "Tu laberinto no está completo: «$enlace» es un enlace, o se llega a él pasando por un enlace (medí: la ruta real de cada carpeta y archivo de la lista contra su lugar en $raiz). Ármalo de nuevo con  prepara 01"
  elif [ -n "$malo" ]; then
    no "Tu laberinto no está completo: falta o cambió «$malo» (medí: cada carpeta y archivo de la lista contra ~/practica/01, con su tamaño). Ármalo de nuevo con  prepara 01"
  else
    si "Tu laberinto está completo (medí: las $cuantos carpetas y archivos de la lista existen en ~/practica/01, ninguno es un enlace y cada archivo tiene su tamaño)"
  fi

  # --- Tu hoja de respuestas -------------------------------------------------------
  if [ ! -f "$hoja" ]; then
    no "Falta tu hoja de respuestas, ~/practica/respuestas/01.md (medí: que el archivo exista). La crea  prepara 01 . Sin ella no puedo revisar tus cuatro respuestas"
    return
  fi

  # --- 1.2 · El archivo más grande -------------------------------------------------
  if ! dicho=$(respuesta_01 "mas-grande"); then
    no "No encontré tu respuesta «mas-grande» (medí: busqué en respuestas/01.md un renglón que empiece con  mas-grande: )"
  elif [ -z "$dicho" ]; then
    no "Tu renglón «mas-grande:» está vacío (medí: lo que hay después de los dos puntos). Anótalo con  anota 01 mas-grande  y el nombre del archivo"
  elif [ "${dicho#*/}" != "$dicho" ]; then
    no "En «mas-grande» anotaste «$dicho», que lleva una diagonal (medí: que la respuesta no tenga / ). Va solo el nombre del archivo, como lo escribe ls, sin su carpeta"
  else
    # ¿Qué es en la lista lo que anotaste? «archivo», «texto», «carpeta» o nada.
    que_es=$(lista_01 | N="$dicho" awk '{ m = $2; sub(/.*\//, "", m) } m == ENVIRON["N"] && $1 != "inicio" && $1 != "destino" { print $1; exit }')
    if [ "$dicho" = "$grande" ]; then
      si "«$dicho» es el archivo más grande del laberinto (medí: comparé los bytes de cada archivo de la lista del laberinto)"
    elif [ "$que_es" = "carpeta" ]; then
      no "«$dicho» es una carpeta, no un archivo (medí: qué es ese nombre en la lista del laberinto). En  ls -l , el renglón de una carpeta empieza con d; el de un archivo, con un guion"
    elif [ -n "$que_es" ]; then
      no "«$dicho» no es el archivo más grande del laberinto (medí: comparé sus bytes contra los de los demás archivos de la lista; hay uno con más). Vuelve a leer la columna del tamaño con  ls -lh : fíjate en la letra, no solo en el número"
    else
      no "«$dicho» no es un archivo del laberinto (medí: busqué ese nombre tal cual, con sus mayúsculas, minúsculas y puntos, en la lista del laberinto). Anota solo el nombre, como lo escribe ls"
    fi
  fi

  # --- 1.2 · El archivo oculto -----------------------------------------------------
  if ! dicho=$(respuesta_01 "oculto"); then
    no "No encontré tu respuesta «oculto» (medí: busqué en respuestas/01.md un renglón que empiece con  oculto: )"
  elif [ -z "$dicho" ]; then
    no "Tu renglón «oculto:» está vacío (medí: lo que hay después de los dos puntos). Anótalo con  anota 01 oculto  y el nombre del archivo"
  elif [ "${dicho#*/}" != "$dicho" ]; then
    no "En «oculto» anotaste «$dicho», que lleva una diagonal (medí: que la respuesta no tenga / ). Va solo el nombre del archivo, como lo escribe ls -a, sin su carpeta"
  elif [ "$dicho" = "$oculto" ]; then
    si "«$dicho» es el archivo oculto del laberinto (medí: es el único archivo de la lista con un nombre que empieza con punto)"
  elif [ ".$dicho" = "$oculto" ]; then
    no "Anotaste «$dicho», sin el punto del principio (medí: comparé tu respuesta, letra por letra, con el nombre del archivo oculto). El punto es parte del nombre: anótalo como lo escribe  ls -a"
  else
    no "«$dicho» no es el archivo oculto del laberinto (medí: comparé tu respuesta con el único archivo de la lista con un nombre que empieza con punto). Búscalo con  ls -a  en la carpeta de las bitácoras"
  fi

  # --- 1.3 · La ruta absoluta ------------------------------------------------------
  if ! dicho=$(respuesta_01 "ruta-absoluta"); then
    no "No encontré tu respuesta «ruta-absoluta» (medí: busqué en respuestas/01.md un renglón que empiece con  ruta-absoluta: )"
  elif [ -z "$dicho" ]; then
    no "Tu renglón «ruta-absoluta:» está vacío (medí: lo que hay después de los dos puntos). Anótalo con  anota 01 ruta-absoluta  y tu ruta"
  elif [ "${dicho#/}" = "$dicho" ]; then
    no "«$dicho» no es una ruta absoluta (medí: que empiece con / ). Una ruta absoluta empieza en la raíz; «~» es una abreviatura, no la raíz"
  else
    fallo=$(ruta_01 "$dicho" "$destino")
    case "$fallo" in
      bien)      si "Tu ruta absoluta lleva a la carpeta destino (medí: empieza con /, existe, ningún tramo es un enlace, y tanto leída letra por letra como siguiéndola de verdad da $destino)" ;;
      no-existe) no "Tu ruta absoluta «$dicho» no existe o no es una carpeta (medí: que exista como carpeta). Compruébala con  cd  y  pwd  antes de anotarla" ;;
      enlace)    no "Tu ruta absoluta «$dicho» pasa por un enlace: un atajo que apunta a otra carpeta (medí: cada tramo de la ruta, que ninguno sea un enlace, y que la ruta leída letra por letra dé la misma carpeta que siguiéndola de verdad). Escribe el camino por las carpetas del laberinto" ;;
      *)         no "Tu ruta absoluta «$dicho» existe, pero no lleva a la carpeta destino (medí: siguiéndola llegué a «$(fisica_01 "$dicho")», no a la carpeta que pide el ejercicio 1.3)" ;;
    esac
  fi

  # --- 1.3 · La ruta relativa ------------------------------------------------------
  # Se prueba pegada a la carpeta de salida: «salida/tu-ruta». Así se lee siempre
  # como ruta, también si es un guion solo o lleva espacios.
  if ! dicho=$(respuesta_01 "ruta-relativa"); then
    no "No encontré tu respuesta «ruta-relativa» (medí: busqué en respuestas/01.md un renglón que empiece con  ruta-relativa: )"
  elif [ -z "$dicho" ]; then
    no "Tu renglón «ruta-relativa:» está vacío (medí: lo que hay después de los dos puntos). Anótalo con  anota 01 ruta-relativa  y tu ruta"
  elif [ "${dicho#/}" != "$dicho" ] || [ "${dicho#\~}" != "$dicho" ]; then
    no "«$dicho» no es una ruta relativa (medí: que NO empiece con / ni con ~ ). Una ruta relativa sale de la carpeta donde estás parado"
  elif [ "$(ruta_01 "$inicio" "$inicio")" != "bien" ]; then
    no "No pude probar tu ruta relativa: falta la carpeta de salida, $inicio, o es un enlace (medí: que exista como carpeta de verdad). Arma el laberinto con  prepara 01"
  else
    fallo=$(ruta_01 "$inicio/$dicho" "$destino")
    case "$fallo" in
      bien)      si "Tu ruta relativa lleva a la carpeta destino (medí: no empieza con / ni con ~, ningún tramo es un enlace, y saliendo de $inicio, tanto leída letra por letra como siguiéndola de verdad, da $destino)" ;;
      no-existe) no "Tu ruta relativa «$dicho» no existe saliendo de $inicio (medí: que exista como carpeta partiendo de ahí). Compruébala parado ahí, con  cd  y  pwd" ;;
      enlace)    no "Tu ruta relativa «$dicho» pasa por un enlace: un atajo que apunta a otra carpeta (medí: saliendo de $inicio, cada tramo de la ruta, que ninguno sea un enlace, y que la ruta leída letra por letra dé la misma carpeta que siguiéndola de verdad). Escribe el camino por las carpetas del laberinto" ;;
      *)         no "Tu ruta relativa «$dicho» existe, pero no lleva a la carpeta destino (medí: saliendo de $inicio llegué a «$(fisica_01 "$inicio/$dicho")», no a la carpeta que pide el ejercicio 1.3)" ;;
    esac
  fi
}

case "${1:-}" in
  00) verifica_00 ;;
  01) verifica_01 ;;
  '') echo "Uso: verifica NN    (NN es el número de la lección; por ejemplo: verifica 01)"; exit 2 ;;
  *)  echo "Todavía no hay verifica para la lección «$1». Por ahora existen: verifica 00 y verifica 01"; exit 2 ;;
esac

echo
if [ "$falta" -eq 0 ]; then
  echo "✅ Lección ${1}: todo en verde."
else
  echo "❌ Lección ${1}: falta lo marcado con ❌. Arréglalo y corre  verifica ${1}  otra vez."
fi
exit "$falta"
