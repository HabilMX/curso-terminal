#!/usr/bin/env bash
# verifica — revisa el ESTADO de tu terminal de práctica y te dice qué falta.
# Corre ADENTRO del contenedor del curso. Uso:  verifica 00
# Solo revisa cómo están las cosas: no califica predicciones ni explicaciones;
# esas las comparas tú con «Compara tus respuestas» de la lección.
# Escribe solo dos cosas, y las dos se dicen en su marca: para saber si ~/practica
# se puede escribir, crea un archivo vacío y lo borra enseguida; y para saber si
# saliste y volviste, anota en ~/practica/00/.sesion-verifica en qué sesión vio tu
# marca por primera vez.
set -uo pipefail

falta=0
si()   { echo "✅ $1"; }
no()   { echo "❌ $1"; falta=1; }

verifica_00() {
  local version usuario practica marca prueba apunte vista

  # --- 0.1 · Estás en la terminal del curso -------------------------------------
  version=$(. /etc/os-release 2>/dev/null && echo "${ID:-?} ${VERSION_ID:-?}")
  if [ "$version" = "ubuntu 26.04" ]; then
    si "Es Ubuntu 26.04 (medí: ID y VERSION_ID en /etc/os-release)"
  else
    no "No es Ubuntu 26.04: /etc/os-release dice «${version:-nada}». ¿Corriste verifica fuera del contenedor? Entra con ./practicar"
  fi

  usuario=$(id -un)
  if [ "$usuario" = "alumno" ]; then
    si "Eres el usuario alumno (medí: id -un)"
  else
    no "Eres «${usuario}», no alumno (medí: id -un). Sal con exit y vuelve a entrar con ./practicar"
  fi

  practica="$HOME/practica"
  if [ -d "$practica" ]; then
    si "$practica existe y es una carpeta (medí: que exista como carpeta)"
  else
    no "$practica no existe (medí: que exista como carpeta). Sal y vuelve a entrar con ./practicar"
  fi

  prueba="$practica/.verifica-prueba.$$"
  if [ -d "$practica" ] && : 2>/dev/null > "$prueba"; then
    rm -f "$prueba"
    si "Puedes escribir en $practica (medí: creé un archivo vacío ahí y lo borré)"
  else
    no "No puedes escribir en $practica (medí: intenté crear un archivo vacío ahí). Sal y corre ./practicar desde-cero"
  fi

  # --- 0.1 · Saliste y volviste a entrar sin perder tu carpeta -------------------
  # No se usa el reloj. ./practicar le pone a cada entrada un identificador distinto
  # (CURSO_TERMINAL_SESION). La primera vez que verifica ve tu marca, apunta en el
  # volumen en qué sesión la vio. Si después corre en OTRA sesión y la marca sigue
  # ahí, es que saliste, volviste y tu carpeta sobrevivió.
  marca="$practica/00/aqui-estuve.txt"
  apunte="$practica/00/.sesion-verifica"
  if [ ! -f "$marca" ]; then
    rm -f "$apunte" 2>/dev/null
    no "Falta $marca (medí: que el archivo exista). Créalo con el paso 2 de la lección, corre  verifica 00, sal con exit y vuelve a entrar"
  elif [ -z "${CURSO_TERMINAL_SESION:-}" ]; then
    no "No sé en qué sesión estás (medí: la variable CURSO_TERMINAL_SESION, que pone ./practicar, está vacía). Sal y entra con ./practicar"
  else
    vista=$(cat "$apunte" 2>/dev/null)
    if [ -z "$vista" ]; then
      if echo "$CURSO_TERMINAL_SESION" 2>/dev/null > "$apunte"; then
        no "Tu marca aqui-estuve.txt ya existe, y es la primera vez que la veo: fue en ESTA sesión (medí: no había apunte de una sesión anterior; lo acabo de dejar en 00/.sesion-verifica). Te falta salir con exit, volver a entrar con ./practicar y correr  verifica 00  otra vez"
      else
        no "Tu marca existe, pero no pude apuntar en qué sesión la vi (medí: intenté escribir 00/.sesion-verifica). Sal y corre ./practicar desde-cero"
      fi
    elif [ "$vista" = "$CURSO_TERMINAL_SESION" ]; then
      no "Tu marca aqui-estuve.txt existe, pero sigues en la misma sesión en que la vi por primera vez (medí: el apunte de 00/.sesion-verifica es de esta sesión). Te falta salir con exit, volver a entrar con ./practicar y correr  verifica 00  otra vez"
    else
      si "Saliste y volviste sin perder tu carpeta (medí: tu marca ya existía en una sesión anterior a esta, según el apunte de 00/.sesion-verifica)"
    fi
  fi
}

case "${1:-}" in
  00) verifica_00 ;;
  '') echo "Uso: verifica NN    (NN es el número de la lección; por ejemplo: verifica 00)"; exit 2 ;;
  *)  echo "Todavía no hay verifica para la lección «$1». Por ahora existe: verifica 00"; exit 2 ;;
esac

echo
if [ "$falta" -eq 0 ]; then
  echo "✅ Lección ${1}: todo en verde."
else
  echo "❌ Lección ${1}: falta lo marcado con ❌. Arréglalo y corre  verifica ${1}  otra vez."
fi
exit "$falta"
