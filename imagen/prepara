#!/usr/bin/env bash
# prepara — arma el escenario de una lección en tu carpeta de práctica.
# Corre ADENTRO del contenedor del curso. Uso:  prepara 01   ·   prepara 02   ·   prepara 03
#
# Es un comando aparte de «verifica», a propósito: verifica solo mira; prepara
# crea y BORRA. Toca dos cosas y nada más:
#   · la carpeta de esa lección (/home/alumno/practica/01 para la 01). Si ya
#     existe, avisa que la va a borrar y pide que escribas  si  antes de hacerlo;
#   · tu hoja de respuestas (/home/alumno/practica/respuestas/01.md): la crea
#     con sus claves vacías SOLO si no existe. Si ya existe, no la toca.
#
# La carpeta de práctica está escrita completa, /home/alumno/practica, y no se
# arma con la variable HOME: así, lo que se borra no depende de una variable.
# Antes de borrar o crear nada se comprueba que esa carpeta, la de la lección y
# la de las respuestas sean carpetas de verdad y no enlaces a otro lugar. Con un
# enlace, «borra practica/01» borraría la carpeta a la que el enlace apunta.
#
# Los escenarios no tienen azar. Los nombres, los tamaños, los contenidos y las
# fechas vienen de una lista fija por lección, la misma que lee verifica:
# /usr/local/share/curso-terminal/01-laberinto.txt, 02-taller.txt y 03-guardia.txt
# La lista se lee COMPLETA y se revisa antes de borrar o crear nada: si una ruta
# se saliera de la carpeta de la lección, prepara no toca nada.
set -u
# Las horas de los escenarios están en UTC, la hora de la terminal de práctica. Se fija
# aquí para que no dependan de cómo esté configurado el reloj.
TZ=UTC; export TZ

LISTAS="/usr/local/share/curso-terminal"
PRACTICA="/home/alumno/practica"

revisar_lugar() {
  local fisica
  if [ "$(id -un)" != "alumno" ]; then
    echo "❌ prepara corre dentro de la terminal de práctica, como alumno (medí: id -un)."
    echo "   Sal y entra con ./practicar"
    exit 1
  fi
  fisica=$(realpath -e -P -- "$PRACTICA" 2>/dev/null)
  if [ -L "$PRACTICA" ] || [ ! -d "$PRACTICA" ] || [ "$fisica" != "$PRACTICA" ]; then
    echo "❌ No preparo nada: $PRACTICA debe ser tu carpeta de práctica, y no un enlace a otro lugar"
    echo "   (medí: que exista como carpeta, que no sea un enlace y que su ruta real sea esa misma)."
    echo "   Sal y entra con ./practicar"
    exit 1
  fi
}

# Se niega a seguir si algo de lo que va a tocar es un enlace. No borra el enlace:
# lo dice y se detiene.
sin_enlaces() {
  local cosa
  for cosa in "$@"; do
    if [ -L "$cosa" ]; then
      echo "❌ No preparo nada: $cosa es un enlace a otro lugar, no una carpeta ni un archivo tuyo"
      echo "   (medí: que no sea un enlace). No lo sigo ni lo borro. Quítalo tú, o sal y corre"
      echo "   ./practicar desde-cero"
      exit 1
    fi
  done
}

# Si la carpeta de la lección ya existe, se borra solo con tu «si».
confirmar_borrado() {
  local carpeta="$1" respuesta
  [ -e "$carpeta" ] || return 0
  echo "Ya existe $carpeta."
  echo "Para armarla de nuevo hay que BORRARLA, con todo lo que tenga adentro. No se puede deshacer."
  echo "No se borra nada más: tu hoja de respuestas se queda como está."
  printf "Para confirmar, escribe  si  y presiona Enter: "
  read -r respuesta || respuesta=""
  case "$respuesta" in
    si|sí|SI|SÍ|Si|Sí) ;;
    *) echo "No se borró nada. Tu carpeta sigue como estaba."; exit 0 ;;
  esac
  rm -rf -- "$carpeta"
}

# La hoja de respuestas nace con sus claves vacías. Si ya existe, no se toca.
dejar_hoja() {
  local carpeta="$PRACTICA/respuestas" hoja="$PRACTICA/respuestas/$1.md"
  shift
  if [ -e "$hoja" ]; then
    echo "   Tu hoja de respuestas ya existía y no la toqué: $hoja"
    return 0
  fi
  [ -d "$carpeta" ] || mkdir "$carpeta" || { echo "❌ No pude crear $carpeta."; exit 1; }
  printf '%s:\n' "$@" > "$hoja" || { echo "❌ No pude crear $hoja."; exit 1; }
  if [ $# -eq 1 ]; then
    echo "   Te dejé la hoja de respuestas, con su clave vacía: $hoja"
  else
    echo "   Te dejé la hoja de respuestas, con sus claves vacías: $hoja"
  fi
}

# Un archivo de relleno de exactamente N bytes: el mismo renglón repetido y
# cortado a la medida. Es texto, por si lo abres.
rellenar() {
  local archivo="$1" bytes="$2" nombre
  nombre=$(basename "$archivo")
  : > "$archivo"
  [ "$bytes" -eq 0 ] && return 0
  yes "$nombre: renglón de relleno del laberinto de la lección 01. No hay nada que leer aquí." \
    | head -c "$bytes" > "$archivo"
}

# Una ruta de la lista tiene que quedar ADENTRO de la carpeta de la lección solo por
# cómo está escrita, sin mirar el disco: no vacía, no absoluta, sin «.» ni «..» como
# tramo y sin tramos vacíos. Así «carpeta/ruta» es siempre hija de «carpeta».
ruta_segura() {
  case "$1" in
    ''|/*|*/|.|..|./*|../*|*/.|*/..|*/./*|*/../*|*//*) return 1 ;;
  esac
  return 0
}

# Lee la lista entera a cuatro arreglos: L_TIPO, L_RUTA, L_FECHA y L_RESTO. Las
# columnas van separadas por un tabulador, así que una ruta puede llevar espacios.
# Argumentos: la lista, la carpeta de la lección (para el mensaje), los tipos que
# llevan una ruta y los que llevan dos (en la segunda columna y en la tercera).
# Con un tipo que no conoce o una ruta que no es segura, se detiene SIN haber
# borrado ni creado nada.
cargar_lista() {
  local lista="$1" raiz="$2" una=" $3 " dos=" $4 " n=0 renglon tipo ruta fecha resto malo
  L_TIPO=(); L_RUTA=(); L_FECHA=(); L_RESTO=()
  while IFS= read -r renglon || [ -n "$renglon" ]; do
    n=$((n + 1))
    [[ $renglon =~ ^[[:space:]]*(#|$) ]] && continue
    # Dos tabuladores seguidos son una columna vacía. read se los saltaría y
    # recorrería las columnas: la fecha acabaría leída como ruta.
    case "$renglon" in
      $'\t'*|*$'\t\t'*)
        echo "❌ Escenario inválido: el renglón $n de $lista tiene una columna vacía."
        echo "   No preparé ni borré nada. Sal y corre  ./practicar reconstruir"
        exit 1 ;;
    esac
    IFS=$'\t' read -r tipo ruta fecha resto <<< "$renglon"
    case "$una$dos" in
      *" $tipo "*) ;;
      *) echo "❌ Escenario inválido: el renglón $n de $lista es de un tipo que no conozco, «$tipo»."
         echo "   No preparé ni borré nada. Sal y corre  ./practicar reconstruir"
         exit 1 ;;
    esac
    malo=$ruta
    if ruta_segura "$ruta"; then
      malo=""
      case "$dos" in *" $tipo "*) ruta_segura "$fecha" || malo=${fecha:-(vacía)} ;; esac
    fi
    if [ -n "$malo" ] || [ -z "$ruta" ]; then
      malo=${malo:-(vacía)}
      echo "❌ Escenario inválido: el renglón $n de $lista trae la ruta «$malo», que no queda adentro de $raiz"
      echo "   (medí: que no esté vacía, que no empiece con / y que no tenga . ni .. ni tramos vacíos)."
      echo "   No preparé ni borré nada. Sal y corre  ./practicar reconstruir"
      exit 1
    fi
    L_TIPO+=("$tipo"); L_RUTA+=("$ruta"); L_FECHA+=("$fecha"); L_RESTO+=("$resto")
  done < "$lista"
}

prepara_01() {
  local lista="$LISTAS/01-laberinto.txt" raiz="$PRACTICA/01"
  local i tipo ruta carpetas=0 archivos=0 mal=0 real

  if [ ! -r "$lista" ]; then
    echo "❌ No encuentro la lista del laberinto (medí: que $lista se pueda leer)."
    echo "   Tu imagen es de antes de esta lección. Sal y corre  ./practicar reconstruir"
    exit 1
  fi
  cargar_lista "$lista" "$raiz" "carpeta archivo texto inicio destino" ""
  sin_enlaces "$raiz" "$PRACTICA/respuestas" "$PRACTICA/respuestas/01.md"
  confirmar_borrado "$raiz"
  mkdir "$raiz" || { echo "❌ No pude crear $raiz. Sal y corre ./practicar desde-cero"; exit 1; }

  # Primera vuelta: se crean las carpetas y los archivos, con permisos fijos.
  for i in "${!L_TIPO[@]}"; do
    tipo=${L_TIPO[i]}; ruta="$raiz/${L_RUTA[i]}"
    case "$tipo" in
      carpeta) mkdir "$ruta" && chmod 755 "$ruta" ;;
      archivo) rellenar "$ruta" "${L_RESTO[i]}" && chmod 644 "$ruta" ;;
      texto)
        cat > "$ruta" <<'LEEME'
Estás en el laberinto de la lección 01 de «La terminal desde cero».

Si te pierdes o descompones algo, corre
    prepara 01
y el laberinto vuelve a quedar como el primer día.

La lección te dice a dónde ir. Para saber dónde estás parado: pwd
LEEME
        chmod 644 "$ruta" ;;
    esac
  done

  # Segunda vuelta: las fechas. Van al final porque crear algo dentro de una
  # carpeta le cambia la fecha a la carpeta.
  for i in "${!L_TIPO[@]}"; do
    case "${L_TIPO[i]}" in
      carpeta|archivo|texto) touch -d "${L_FECHA[i]/T/ }" "$raiz/${L_RUTA[i]}" ;;
    esac
  done
  touch -d "2025-06-02 08:00" "$raiz"

  # Tercera vuelta: se mide lo que quedó, contra la misma lista.
  for i in "${!L_TIPO[@]}"; do
    ruta="$raiz/${L_RUTA[i]}"
    case "${L_TIPO[i]}" in
      carpeta) if [ -d "$ruta" ]; then carpetas=$((carpetas + 1)); else mal=1; fi ;;
      texto)   if [ -f "$ruta" ]; then archivos=$((archivos + 1)); else mal=1; fi ;;
      archivo)
        real=$(stat -c %s "$ruta" 2>/dev/null)
        if [ "${real:-x}" = "${L_RESTO[i]}" ]; then archivos=$((archivos + 1)); else mal=1; fi ;;
    esac
  done

  if [ "$mal" -ne 0 ]; then
    echo "❌ El laberinto no quedó completo (medí: cada carpeta y cada archivo de la lista, con su tamaño)."
    echo "   Corre  prepara 01  otra vez. Si se repite, sal y corre ./practicar desde-cero"
    exit 1
  fi
  echo "✅ Laberinto listo en $raiz (medí: $carpetas carpetas y $archivos archivos, cada archivo con su tamaño)."
  dejar_hoja 01 mas-grande oculto ruta-absoluta ruta-relativa
  echo "   Empieza por ahí:  cd ~/practica/01"
}

# --- Lección 02 ---------------------------------------------------------------------
# El taller: carpetas y archivos para copiar, mover, renombrar y borrar. Cada archivo
# tiene un renglón de texto distinto, para que verifica pueda saber, por su contenido,
# si una copia es la buena o si un archivo se sobrescribió.
prepara_02() {
  local lista="$LISTAS/02-taller.txt" raiz="$PRACTICA/02"
  local i ruta carpetas=0 archivos=0 mal=0

  if [ ! -r "$lista" ]; then
    echo "❌ No encuentro la lista del taller (medí: que $lista se pueda leer)."
    echo "   Tu imagen es de antes de esta lección. Sal y corre  ./practicar reconstruir"
    exit 1
  fi
  cargar_lista "$lista" "$raiz" \
    "carpeta archivo crea-carpeta crea-archivo borra-patron borra queda" \
    "copia copia-carpeta renombra mueve"
  sin_enlaces "$raiz" "$PRACTICA/respuestas" "$PRACTICA/respuestas/02.md"
  confirmar_borrado "$raiz"
  mkdir "$raiz" || { echo "❌ No pude crear $raiz. Sal y corre ./practicar desde-cero"; exit 1; }

  # Primera vuelta: carpetas y archivos, con permisos fijos. Solo los renglones
  # «carpeta» y «archivo»: los demás son lo que pide cada ejercicio.
  for i in "${!L_TIPO[@]}"; do
    ruta="$raiz/${L_RUTA[i]}"
    case "${L_TIPO[i]}" in
      carpeta) mkdir "$ruta" && chmod 755 "$ruta" ;;
      archivo) printf '%s\n' "${L_RESTO[i]}" > "$ruta" && chmod 644 "$ruta" ;;
    esac
  done

  # Segunda vuelta: las fechas, al final, porque crear algo dentro de una carpeta
  # le cambia la fecha a la carpeta.
  for i in "${!L_TIPO[@]}"; do
    case "${L_TIPO[i]}" in
      carpeta|archivo) touch -d "${L_FECHA[i]/T/ }" "$raiz/${L_RUTA[i]}" ;;
    esac
  done
  touch -d "2025-06-02 00:10" "$raiz"

  # Tercera vuelta: se mide lo que quedó, contra la misma lista.
  for i in "${!L_TIPO[@]}"; do
    ruta="$raiz/${L_RUTA[i]}"
    case "${L_TIPO[i]}" in
      carpeta) if [ -d "$ruta" ] && [ ! -L "$ruta" ]; then carpetas=$((carpetas + 1)); else mal=1; fi ;;
      archivo)
        if [ -f "$ruta" ] && [ ! -L "$ruta" ] && cmp -s -- "$ruta" <(printf '%s\n' "${L_RESTO[i]}"); then
          archivos=$((archivos + 1))
        else
          mal=1
        fi ;;
    esac
  done

  if [ "$mal" -ne 0 ]; then
    echo "❌ El taller no quedó completo (medí: cada carpeta y cada archivo de la lista, con su contenido)."
    echo "   Corre  prepara 02  otra vez. Si se repite, sal y corre ./practicar desde-cero"
    exit 1
  fi
  echo "✅ Taller listo en $raiz (medí: $carpetas carpetas y $archivos archivos, cada archivo con su contenido)."
  dejar_hoja 02 patron
  echo "   Empieza por ahí:  cd ~/practica/02"
}

# --- Lección 03 ---------------------------------------------------------------------
# La sala de guardia: archivos para LEER. Una bitácora larga, la de ayer comprimida, una
# configuración, un CSV y dos archivos de ensayo. Las bitácoras no se escriben en la lista
# renglón por renglón: se arman con una regla fija (está explicada en la lista) y al final
# se comprueba su huella, el sha256 que la lista dice que deben tener.

# Segundos desde 1970-01-01 00:00 UTC de una fecha «AAAA-MM-DDThh:mm:ss», sin llamar a
# date: es la cuenta de días del calendario civil. Así la hora de cada renglón sale igual
# en cualquier máquina, con cualquier versión de date.
segundos_utc() {
  local f="$1" a m d mp era aa dia
  a=$((10#${f:0:4})); m=$((10#${f:5:2})); d=$((10#${f:8:2}))
  [ "$m" -le 2 ] && a=$((a - 1))
  era=$((a / 400)); aa=$((a - era * 400)); mp=$(((m + 9) % 12))
  dia=$(((153 * mp + 2) / 5 + d - 1))
  dia=$((era * 146097 + aa * 365 + aa / 4 - aa / 100 + dia - 719468))
  echo $((dia * 86400 + 10#${f:11:2} * 3600 + 10#${f:14:2} * 60 + 10#${f:17:2}))
}

# Escribe a la salida el texto de una bitácora: la ruta (para buscar sus eventos), el
# inicio, el paso en segundos, cuántos renglones, la semilla y desde qué renglón se rechaza.
# Los eventos de esa ruta ya están en EVENTO_03 («ruta|n» → «NIVEL<tab>mensaje»).
armar_bitacora() {
  local ruta="$1" paso="$3" total="$4" semilla="$5" rechaza="$6"
  local inicio n t hora nivel mensaje folio centavos resultado
  local -a renglones=()
  inicio=$(segundos_utc "$2")
  for ((n = 1; n <= total; n++)); do
    t=$((inicio + (n - 1) * paso))
    printf -v hora '%(%Y-%m-%d %H:%M:%S)T' "$t"
    if [ -n "${EVENTO_03["$ruta|$n"]+x}" ]; then
      IFS=$'\t' read -r nivel mensaje <<< "${EVENTO_03["$ruta|$n"]}"
      printf -v "renglones[n]" '%s %-5s %s' "$hora" "$nivel" "$mensaje"
      continue
    fi
    folio=$((100000 + (n * 7919 + semilla) % 89999))
    centavos=$((2000 + (n * 7351 + semilla * 13) % 148000))
    if [ "$rechaza" -ne 0 ] && [ "$n" -gt "$rechaza" ]; then
      resultado="rechazado motivo=sin-lote"
    else
      resultado="aprobado"
    fi
    printf -v "renglones[n]" '%s INFO  cobro F-%06d monto=%d.%02d resultado=%s' \
      "$hora" "$folio" $((centavos / 100)) $((centavos % 100)) "$resultado"
  done
  printf '%s\n' "${renglones[@]}"
}

# El texto de un «numerado»: «renglón 001 de 100» y así hasta N.
armar_numerado() {
  local n total="$1"
  for ((n = 1; n <= total; n++)); do printf 'renglón %03d de %d\n' "$n" "$total"; done
}

huella() { sha256sum | { read -r h _; echo "$h"; }; }

prepara_03() {
  local lista="$LISTAS/03-guardia.txt" raiz="$PRACTICA/03"
  local i tipo ruta resto carpetas=0 archivos=0 mal=0 claves=()
  local inicio paso total semilla rechaza esperada
  local -A ES_TEXTO=() ES_BITACORA=() TEXTO_03=()
  declare -gA EVENTO_03=()

  if [ ! -r "$lista" ]; then
    echo "❌ No encuentro la lista de la sala de guardia (medí: que $lista se pueda leer)."
    echo "   Tu imagen es de antes de esta lección. Sal y corre  ./practicar reconstruir"
    exit 1
  fi
  cargar_lista "$lista" "$raiz" \
    "carpeta texto linea numerado bitacora bitacora-gz evento crece pregunta" ""

  # Segunda revisión, todavía sin tocar nada: cada «linea», «evento» y «crece» tiene que
  # ser de un archivo que la lista arma, y los números tienen que ser números.
  for i in "${!L_TIPO[@]}"; do
    case "${L_TIPO[i]}" in
      texto) ES_TEXTO[${L_RUTA[i]}]=1 ;;
      bitacora|bitacora-gz) ES_BITACORA[${L_RUTA[i]}]=1 ;;
    esac
  done
  for i in "${!L_TIPO[@]}"; do
    tipo=${L_TIPO[i]}; ruta=${L_RUTA[i]}; resto=${L_RESTO[i]}
    case "$tipo" in
      linea|crece) [ -n "${ES_TEXTO[$ruta]+x}" ] || mal="$ruta (un «$tipo» de un archivo que la lista no arma)" ;;
      evento)
        [ -n "${ES_BITACORA[$ruta]+x}" ] || mal="$ruta (un evento de una bitácora que la lista no arma)"
        [[ ${L_FECHA[i]} =~ ^[1-9][0-9]*$ ]] || mal="$ruta (un evento sin número de renglón)"
        EVENTO_03["$ruta|${L_FECHA[i]}"]=$resto ;;
      numerado) [[ $resto =~ ^[1-9][0-9]*$ ]] || mal="$ruta (sin cuántos renglones)" ;;
      bitacora|bitacora-gz)
        IFS=$'\t' read -r inicio paso total semilla rechaza esperada <<< "$resto"
        [[ $inicio =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] \
          && [[ "$paso $total $semilla $rechaza" =~ ^[0-9]+\ [1-9][0-9]*\ [0-9]+\ [0-9]+$ ]] \
          && [[ $esperada =~ ^[0-9a-f]{64}$ ]] || mal="$ruta (una bitácora con columnas que no entiendo)" ;;
      pregunta) claves+=("${L_FECHA[i]}") ;;
    esac
    [ "$mal" = 0 ] || break
  done
  # Y cada bitácora se arma primero en memoria, para comprobar su huella ANTES de borrar
  # la sala: si la regla no da el texto que la lista espera, no se toca nada.
  if [ "$mal" = 0 ]; then
    for i in "${!L_TIPO[@]}"; do
      case "${L_TIPO[i]}" in bitacora|bitacora-gz) ;; *) continue ;; esac
      IFS=$'\t' read -r inicio paso total semilla rechaza esperada <<< "${L_RESTO[i]}"
      if [ "$(armar_bitacora "${L_RUTA[i]}" "$inicio" "$paso" "$total" "$semilla" "$rechaza" | huella)" != "$esperada" ]; then
        mal="${L_RUTA[i]} (la bitácora no sale con la huella que dice la lista)"
        break
      fi
    done
  fi
  if [ "$mal" != 0 ]; then
    echo "❌ Escenario inválido: $mal."
    echo "   No preparé ni borré nada. Sal y corre  ./practicar reconstruir"
    exit 1
  fi

  sin_enlaces "$raiz" "$PRACTICA/respuestas" "$PRACTICA/respuestas/03.md"
  confirmar_borrado "$raiz"
  mkdir "$raiz" || { echo "❌ No pude crear $raiz. Sal y corre ./practicar desde-cero"; exit 1; }

  # Primera vuelta: carpetas y archivos, con permisos fijos. Los renglones de cada texto
  # se juntan antes, en orden, y el archivo se escribe de una vez.
  for i in "${!L_TIPO[@]}"; do
    [ "${L_TIPO[i]}" = "linea" ] && TEXTO_03[${L_RUTA[i]}]+="${L_FECHA[i]}"$'\n'
  done
  for i in "${!L_TIPO[@]}"; do
    ruta="$raiz/${L_RUTA[i]}"; resto=${L_RESTO[i]}
    case "${L_TIPO[i]}" in
      carpeta)  mkdir "$ruta" && chmod 755 "$ruta" ;;
      texto)    printf '%s' "${TEXTO_03[${L_RUTA[i]}]-}" > "$ruta" && chmod 644 "$ruta" ;;
      numerado) armar_numerado "$resto" > "$ruta" && chmod 644 "$ruta" ;;
      bitacora|bitacora-gz)
        IFS=$'\t' read -r inicio paso total semilla rechaza esperada <<< "$resto"
        if [ "${L_TIPO[i]}" = "bitacora" ]; then
          armar_bitacora "${L_RUTA[i]}" "$inicio" "$paso" "$total" "$semilla" "$rechaza" > "$ruta"
        else
          # -n: sin el nombre ni la hora del archivo original adentro, para que el .gz no
          # dependa de cuándo se armó.
          armar_bitacora "${L_RUTA[i]}" "$inicio" "$paso" "$total" "$semilla" "$rechaza" | gzip -n -9 > "$ruta"
        fi
        chmod 644 "$ruta" ;;
    esac
  done

  # Segunda vuelta: las fechas, al final, porque crear algo dentro de una carpeta le
  # cambia la fecha a la carpeta.
  for i in "${!L_TIPO[@]}"; do
    case "${L_TIPO[i]}" in
      carpeta|texto|numerado|bitacora|bitacora-gz) touch -d "${L_FECHA[i]/T/ }" "$raiz/${L_RUTA[i]}" ;;
    esac
  done
  touch -d "2025-06-12 03:12" "$raiz"

  # Tercera vuelta: se mide lo que quedó, contra la misma lista.
  for i in "${!L_TIPO[@]}"; do
    ruta="$raiz/${L_RUTA[i]}"; resto=${L_RESTO[i]}
    case "${L_TIPO[i]}" in
      carpeta)
        if [ -d "$ruta" ] && [ ! -L "$ruta" ]; then carpetas=$((carpetas + 1)); else mal=1; fi ;;
      texto|numerado|bitacora|bitacora-gz)
        if [ ! -f "$ruta" ] || [ -L "$ruta" ]; then mal=1; continue; fi
        case "${L_TIPO[i]}" in
          texto)    cmp -s -- "$ruta" <(printf '%s' "${TEXTO_03[${L_RUTA[i]}]-}") || mal=1 ;;
          numerado) cmp -s -- "$ruta" <(armar_numerado "$resto") || mal=1 ;;
          bitacora)
            IFS=$'\t' read -r _ _ _ _ _ esperada <<< "$resto"
            [ "$(huella < "$ruta")" = "$esperada" ] || mal=1 ;;
          bitacora-gz)
            IFS=$'\t' read -r _ _ _ _ _ esperada <<< "$resto"
            [ "$(gzip -dc -- "$ruta" | huella)" = "$esperada" ] || mal=1 ;;
        esac
        [ "$mal" -eq 0 ] && archivos=$((archivos + 1)) ;;
    esac
  done

  if [ "$mal" -ne 0 ]; then
    echo "❌ La sala no quedó completa (medí: cada carpeta y cada archivo de la lista; los textos, renglón"
    echo "   por renglón, y las bitácoras, por su huella). Corre  prepara 03  otra vez. Si se repite, sal"
    echo "   y corre ./practicar reconstruir"
    exit 1
  fi
  echo "✅ Sala de guardia lista en $raiz (medí: $carpetas carpetas y $archivos archivos, cada uno con"
  echo "   su contenido; las dos bitácoras, por su huella)."
  dejar_hoja 03 "${claves[@]}"
  echo "   Empieza por ahí:  cd ~/practica/03"
}

case "${1:-}" in
  01) revisar_lugar; prepara_01 ;;
  02) revisar_lugar; prepara_02 ;;
  03) revisar_lugar; prepara_03 ;;
  '') echo "Uso: prepara NN    (NN es el número de la lección; por ejemplo: prepara 03)"; exit 2 ;;
  *)  echo "Todavía no hay prepara para la lección «$1». Por ahora existen: prepara 01, prepara 02 y prepara 03"; exit 2 ;;
esac
